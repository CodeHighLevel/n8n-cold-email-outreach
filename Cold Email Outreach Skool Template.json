        "jsonSchemaExample": "{\n\t\"icebreaker\": \"Love what you're doing with Effective Sign Works. Bob's philosophy of 'only as good as your last job' really resonates. Wanted to reach out.\",\n    \"custom_company_name\": \"Effective Sign Works\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
